# Copy this file to .env and fill in your values. Vite only exposes variables
# prefixed with VITE_ to the browser.

# Optional: URL of a Google Sheet published as CSV (File > Share > Publish to web > CSV).
# If left empty, the site shows the bundled sample products instead.
VITE_PRODUCTS_CSV_URL=

# WhatsApp number customers will message, in international format, digits only (no + or spaces).
# Example for an Indian number +91 98765 43210 -> 919876543210
VITE_WHATSAPP_NUMBER=

# Shown in the navbar, footer and WhatsApp messages.
VITE_BUSINESS_NAME=Crokary
